# EmailJS powers the contact form (https://dashboard.emailjs.com).
# All three values are public by design; they ship in the browser bundle.
# Vite reads them at build time, so set them in Vercel before deploying.
#
# Template setup in the EmailJS dashboard:
#   To Email:  your inbox
#   Reply To:  {{email}}
#   Subject:   New message from {{name}}
#   Body:      Name: {{name}} / Email: {{email}} / Company: {{company}} / {{message}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
